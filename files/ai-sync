#!/usr/bin/env python3
#
# ai-sync — wire each present tool to the shared, agent-neutral sources, driven
# entirely by ~/.config/ai/agent-map.json. Deployed by setup; do not edit — edit
# setup's source (files/ai-sync) instead.
#
# One engine for both operating scenarios: stage 09 runs it on the local host,
# cloud.sh in a cloud session. It builds the ~/.config/ai hub (with --workspace),
# lays the "link" symlinks and "import" @stubs, and renders the "generate" and
# "wrap" formats. It loops the manifest generically — no tool is hardcoded;
# adding one is a manifest edit.
#
# Wiring (hub, link, import) follows detect -> decide -> never clobber: an
# absent path, or an empty file, is created; the correct link or stub is a
# no-op; anything else is a conflict, reported and left untouched, and makes
# the exit status 2 so the playbook halts on it. Emitters are add-only and
# non-destructive: they add what is missing, leave anything already present
# (reporting a divergent same-named item as a conflict), and never delete.
# Uses only the standard library (works on the system python3, 3.9+).

import argparse
import json
import os
import re
import sys

for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except (AttributeError, ValueError):
        pass

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config", "ai")
MANIFEST = os.path.join(CONFIG, "agent-map.json")

changed = []
conflicts = []
insync = []
wiring_conflicts = []  # hub/link/import divergence: the playbook halts on it
DRY_RUN = False


def expand(path):
    return os.path.expanduser(path)


def load_json_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
        return json.loads(text) if text.strip() else {}
    except FileNotFoundError:
        return None
    except (ValueError, OSError) as exc:
        sys.stderr.write("✗ error: cannot read %s: %s\n" % (path, exc))
        return None


def mcp_servers_from(source_path):
    data = load_json_file(source_path)
    if not isinstance(data, dict):
        return {}
    servers = data.get("mcpServers")
    return servers if isinstance(servers, dict) else {}


def write_atomic(path, text):
    if DRY_RUN:
        return
    tmp = path + ".ai-sync.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


def makedirs(path):
    if not DRY_RUN:
        os.makedirs(path, mode=0o755, exist_ok=True)


def remove(path):
    if not DRY_RUN:
        os.remove(path)


def symlink(source, path):
    if not DRY_RUN:
        os.symlink(source, path)


def plain_file_body(path):
    """The text of a regular file (not a symlink or directory), else None."""
    if os.path.islink(path) or not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


# ── Wiring: the hub, and link/import entries ─────────────────────────────

def build_hub(manifest, workspace):
    # ~/.config/ai/<source> -> <workspace>/<subdir>/<source>, only for sources
    # the workspace repo provides (so no dangling links). A hub symlink is
    # setup's own and is repointed when it leads elsewhere; a real file or
    # directory at a hub path is someone's content and is never replaced.
    hub = manifest.get("hub", {})
    subdir = hub.get("workspace_subdir", "ai")
    makedirs(CONFIG)
    for name in hub.get("sources", []):
        source = os.path.join(workspace, subdir, name)
        path = os.path.join(CONFIG, name)
        if not os.path.exists(source):
            continue
        if os.path.islink(path):
            if os.readlink(path) == source:
                insync.append(path)
                continue
            remove(path)
        elif os.path.lexists(path):
            wiring_conflicts.append("%s: holds real content, not a hub link "
                                    "(left as-is)" % path)
            continue
        symlink(source, path)
        changed.append("%s -> %s" % (path, source))


def wire_entry(entry):
    # Point a tool's own path at a hub source: a symlink ("link"), or a
    # one-line @import stub ("import") for tools that rewrite their own file.
    source = os.path.join(CONFIG, entry["source"])
    if not os.path.exists(source):
        return
    path = expand(entry["path"])
    stub = "@" + source
    body = plain_file_body(path)
    if entry["sync"] == "link":
        if os.path.islink(path) and os.readlink(path) == source:
            insync.append(path)
            return
    elif body is not None and body.strip() == stub:
        insync.append(path)
        return
    if os.path.lexists(path) and not (body is not None and body.strip() == ""):
        wiring_conflicts.append("%s: holds content, not the shared %s (left as-is)"
                                % (path, "link" if entry["sync"] == "link" else "stub"))
        return
    makedirs(os.path.dirname(path))
    if entry["sync"] == "link":
        if os.path.lexists(path):
            remove(path)  # an empty file
        symlink(source, path)
    else:
        write_atomic(path, stub + "\n")
        if not DRY_RUN:
            os.chmod(path, 0o644)
    changed.append("%s -> %s" % (path, source))


def toml_key(name):
    # Bare TOML keys allow only A-Za-z0-9_-; anything else must be quoted.
    if re.fullmatch(r"[A-Za-z0-9_-]+", name):
        return name
    return json.dumps(name)


# ── Emitters: (entry, source_path) -> mutate entry's target file ──────────

def emit_mcp_json(entry, source_path):
    servers = mcp_servers_from(source_path)
    if not servers:
        return
    path = expand(entry["path"])
    key = entry.get("key", "mcpServers")
    if os.path.exists(path):
        data = load_json_file(path)
        if data is None:
            return
    elif entry.get("create", True):
        data = {}
    else:
        return
    if not isinstance(data, dict):
        sys.stderr.write("! skip %s: top level is not an object\n" % path)
        return
    existing = data.get(key)
    if not isinstance(existing, dict):
        existing = {}
    added = 0
    for name, spec in servers.items():
        if name in existing:
            (insync if existing[name] == spec
             else conflicts).append("%s: %s%s" % (path, name,
                                     "" if existing[name] == spec else " differs (left as-is)"))
            continue
        existing[name] = spec
        added += 1
    if added:
        data[key] = existing
        write_atomic(path, json.dumps(data, indent=2) + "\n")
        changed.append("%s (+%d server(s))" % (path, added))


def render_toml_table(name, spec):
    lines = ["[mcp_servers.%s]" % toml_key(name)]
    if "command" in spec:
        lines.append("command = %s" % json.dumps(spec["command"]))
    if isinstance(spec.get("args"), list):
        lines.append("args = %s" % json.dumps(spec["args"]))
    env = spec.get("env")
    if isinstance(env, dict) and env:
        lines.append("[mcp_servers.%s.env]" % toml_key(name))
        for env_key in env:
            lines.append("%s = %s" % (toml_key(env_key), json.dumps(env[env_key])))
    return "\n".join(lines)


def emit_mcp_toml(entry, source_path):
    # No TOML parser in the stdlib before 3.11, so operate on text: a server is
    # present iff its table header exists. Add-only; never edits an existing one.
    servers = mcp_servers_from(source_path)
    if not servers:
        return
    path = expand(entry["path"])
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except FileNotFoundError:
        text = ""
    except OSError as exc:
        sys.stderr.write("! skip %s: %s\n" % (path, exc))
        return
    additions = []
    for name, spec in servers.items():
        header = re.compile(r"(?m)^\s*\[mcp_servers\.(?:%s|%s)\]"
                            % (re.escape(name), re.escape(json.dumps(name))))
        if header.search(text):
            insync.append("%s: %s" % (path, name))
        else:
            additions.append(render_toml_table(name, spec))
    if additions:
        if text and not text.endswith("\n"):
            text += "\n"
        write_atomic(path, text + "\n" + "\n\n".join(additions) + "\n")
        changed.append("%s (+%d server(s))" % (path, len(additions)))


COPILOT_MARK = "generated by ai-sync from "


def _copilot_instruction_doc(rel_source, body):
    # applyTo: "**" is the only frontmatter the Copilot CLI acts on; the
    # provenance marker rides in the body as an inert comment, so ai-sync
    # recognizes its own output without depending on the tool tolerating extra
    # frontmatter keys.
    if not body.endswith("\n"):
        body += "\n"
    return ('---\napplyTo: "**"\n---\n'
            '<!-- %s%s — edit the source, not this file -->\n\n'
            % (COPILOT_MARK, rel_source) + body)


def emit_copilot_instructions(entry, source_path):
    # Render each hub rule (source_path = ~/.config/ai/rules/*.md) as an
    # always-on Copilot instructions file under entry["path"]. Unlike the MCP
    # emitters (which merge into a shared, user-owned file), these are fully
    # OWNED derived artifacts: written when missing, UPDATED in place when the
    # source changes, and PRUNED when the source is gone — but a same-named file
    # ai-sync did not write (no marker) is reported as a conflict, never
    # clobbered.
    target = expand(entry["path"])
    wanted = {}
    if os.path.isdir(source_path):
        for name in sorted(os.listdir(source_path)):
            if not name.endswith(".md"):
                continue
            try:
                with open(os.path.join(source_path, name), encoding="utf-8") as fh:
                    body = fh.read()
            except OSError:
                continue
            wanted[name[:-3] + ".instructions.md"] = _copilot_instruction_doc(
                "ai/rules/" + name, body)
    if wanted and not os.path.isdir(target):
        try:
            makedirs(target)
        except OSError as exc:
            sys.stderr.write("! skip %s: %s\n" % (target, exc))
            return
    for out_name, content in wanted.items():
        path = os.path.join(target, out_name)
        if not os.path.exists(path):
            write_atomic(path, content)
            changed.append("%s (created)" % path)
            continue
        try:
            with open(path, encoding="utf-8") as fh:
                current = fh.read()
        except OSError as exc:
            conflicts.append("%s: unreadable (%s)" % (path, exc))
            continue
        if COPILOT_MARK not in current:
            conflicts.append("%s: not generated by ai-sync (left as-is)" % path)
        elif current != content:
            write_atomic(path, content)
            changed.append("%s (updated)" % path)
        else:
            insync.append(path)
    # Prune our own outputs whose source rule no longer exists: list the target
    # dir and drop each file we generated (marker present) that no current rule
    # maps to. Runs even when `wanted` is empty, so removing the last rule (or
    # the whole rules/ dir, leaving a dangling hub symlink) cleans up its
    # generated file too.
    if not os.path.isdir(target):
        return
    for f in sorted(os.listdir(target)):
        if not f.endswith(".instructions.md") or f in wanted:
            continue
        path = os.path.join(target, f)
        try:
            with open(path, encoding="utf-8") as fh:
                current = fh.read()
        except OSError:
            continue
        if COPILOT_MARK in current:
            try:
                remove(path)
                changed.append("%s (pruned; source removed)" % path)
            except OSError as exc:
                conflicts.append("%s: could not prune (%s)" % (path, exc))


# A session-start entry's source is the refresh command (--session-start-command)
# rather than a hub file. A SessionStart hook running "cloud.sh --session-start"
# that differs from the command is an earlier registration: reported, not
# replaced.
SESSION_START_OURS = re.compile(r"cloud\.sh'? --session-start(?: |$)")


def emit_claude_session_start(entry, command):
    path = expand(entry["path"])
    if os.path.exists(path):
        data = load_json_file(path)
        if data is None:
            return
    else:
        data = {}
    hooks = data.get("hooks", {}) if isinstance(data, dict) else None
    groups = hooks.get("SessionStart", []) if isinstance(hooks, dict) else None
    if not isinstance(groups, list):
        conflicts.append("%s: unexpected shape (left as-is)" % path)
        return
    for group in groups:
        for hook in (group.get("hooks", []) if isinstance(group, dict) else []):
            current = hook.get("command") if isinstance(hook, dict) else None
            if current == command:
                insync.append("%s: SessionStart" % path)
                return
            if isinstance(current, str) and SESSION_START_OURS.search(current):
                conflicts.append("%s: SessionStart runs %s (left as-is)"
                                 % (path, current))
                return
    groups.append({"matcher": "startup|resume",
                   "hooks": [{"type": "command", "command": command,
                              "timeout": 120}]})
    hooks["SessionStart"] = groups
    data["hooks"] = hooks
    if not os.path.isdir(os.path.dirname(path)):
        makedirs(os.path.dirname(path))
    write_atomic(path, json.dumps(data, indent=2) + "\n")
    changed.append("%s (+SessionStart hook)" % path)


EMITTERS = {
    "mcp-json": emit_mcp_json,
    "mcp-toml": emit_mcp_toml,
    "copilot-instructions": emit_copilot_instructions,
    "claude-session-start": emit_claude_session_start,
}


def main(argv=None):
    global DRY_RUN
    parser = argparse.ArgumentParser(
        prog="ai-sync",
        description="Wire each present tool to the shared AI sources.")
    parser.add_argument("--scenario", choices=("local", "cloud"), default="local",
                        help="operating scenario; entries whose 'scenarios' "
                             "exclude it are skipped (default: local)")
    parser.add_argument("--workspace", metavar="DIR",
                        help="build the ~/.config/ai hub from DIR's shared "
                             "sources before wiring")
    parser.add_argument("--session-start-command", metavar="CMD",
                        help="the refresh command session-start entries register")
    parser.add_argument("--manifest", metavar="PATH", default=MANIFEST,
                        help="the sync manifest (default: ~/.config/ai/agent-map.json)")
    parser.add_argument("--dry-run", action="store_true",
                        help="report what would change without writing")
    args = parser.parse_args(argv)
    DRY_RUN = args.dry_run

    manifest = load_json_file(args.manifest)
    if not isinstance(manifest, dict):
        sys.stderr.write("✗ error: no usable manifest at %s\n" % args.manifest)
        sys.exit(1)
    detect = manifest.get("detect", {})

    def present(tool):
        d = detect.get(tool)
        return bool(d) and os.path.isdir(expand(d))

    if args.workspace:
        build_hub(manifest, os.path.abspath(expand(args.workspace)))

    # Only the distribute lane is machine-applied; harvest is cataloged
    # read-only by ~/bin/ai-harvest, and non-reusable is data no engine
    # touches.
    acted = False
    for entry in manifest.get("entries", {}).get("distribute", []):
        # Match scope by its base (user vs workspace); a :path suffix
        # refines but does not change which engine owns the entry.
        if entry.get("scope", "").split(":", 1)[0] != "user":
            continue
        if args.scenario not in entry.get("scenarios", ("local", "cloud")):
            continue
        sync = entry.get("sync")
        if sync not in ("link", "import", "generate", "wrap"):
            continue
        if not entry.get("path") or not present(entry["tool"]):
            continue
        acted = True
        if sync in ("link", "import"):
            wire_entry(entry)
            continue
        emitter = EMITTERS.get(entry.get("format"))
        if emitter is None:
            sys.stderr.write("! skip %s: no emitter for format '%s'\n"
                             % (entry["path"], entry.get("format")))
            continue
        if entry.get("class") == "session-start":
            if not args.session_start_command:
                sys.stderr.write("! skip %s: no --session-start-command given\n"
                                 % entry["path"])
                continue
            emitter(entry, args.session_start_command)
        else:
            emitter(entry, os.path.join(CONFIG, entry["source"]))

    verb = "would change" if DRY_RUN else "changed"
    for item in changed:
        print("→ %s: %s" % (verb, item))
    for item in wiring_conflicts + conflicts:
        print("! conflict: %s" % item)
    if not changed and not conflicts and not wiring_conflicts:
        print("→ nothing to sync" if not acted else "→ all present tools already in sync")
    if wiring_conflicts:
        sys.exit(2)


if __name__ == "__main__":
    main()
