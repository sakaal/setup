#!/bin/sh
#
# git-credential-github — git credential helper that fetches the
# GitHub Personal Access Token from Proton Pass on demand. Configured
# via:
#
#   git config --global credential.https://github.com.helper "$HOME/bin/git-credential-github"
#
# git invokes the helper with `get`/`store`/`erase` as the first arg.
# We only respond to `get`; the others are no-ops since we don't
# manage local cache state — Pass is the source of truth.
#
# Deployed by setup; do not edit. Edit setup's source instead.
#
# If Pass can't answer (locked session, missing item), print nothing: git then
# falls through to its other helpers or a prompt, instead of trying empty
# credentials and reporting a misleading authentication failure.

case "$1" in
  get)
    user="$(pass-cli item view 'pass://Setup Keys/github-pat/username')" || exit 0
    token="$(pass-cli item view 'pass://Setup Keys/github-pat/password')" || exit 0
    [ -n "$user" ] && [ -n "$token" ] || exit 0
    printf 'username=%s\npassword=%s\n' "$user" "$token"
    ;;
esac
